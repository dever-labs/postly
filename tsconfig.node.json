{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["src/shared/**/*", "electron.vite.config.*", "src/main/**/*", "src/preload/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@main/*": ["./src/main/*"]
    }
  }
}
